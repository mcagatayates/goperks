# --- IMAP (email kaynağı) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# Etsy sipariş bildirimlerini okuduğunuz klasör (çoğu hesapta INBOX)
IMAP_FOLDER=INBOX
# İşlenen e-postaların taşınacağı klasör (opsiyonel, boş bırakılırsa sadece \Seen işaretlenir)
IMAP_PROCESSED_FOLDER=
# Sipariş bildirimlerinin geldiği gönderici adresi
ETSY_SENDER_EMAIL=transaction@etsy.com

# --- Logo İşbaşı API ---
# Test ortamı: https://soho-isbasi-mwv2-test.logo-paas.com
# Canlıya geçerken bu değeri gerçek (production) base URL ile değiştirin.
LOGO_API_BASE_URL=https://soho-isbasi-mwv2-test.logo-paas.com
LOGO_API_KEY=
LOGO_USERNAME=
LOGO_PASSWORD=

# --- Fatura varsayılanları (örnek faturanızdaki değerlerle eşleşir) ---
# KDV muafiyet kodu / açıklaması — muhasebecinizle teyit edin
LOGO_KDV_EXEMPTION_CODE=302/11/1-a
LOGO_KDV_EXEMPTION_DESC=Hizmet İhracı
LOGO_INVOICE_CURRENCY=TL
LOGO_INVOICE_TEMPLATE=Toptan Satış Faturası (KDV Hariç)
# Yabancı bireysel müşteriler için kullandığınız yer tutucu T.C. Kimlik No
LOGO_FOREIGN_CUSTOMER_TCKN=2222222222

# USD -> TL çevrimi için TCMB kuru: ForexBuying | ForexSelling | BanknoteBuying | BanknoteSelling
TCMB_RATE_TYPE=ForexSelling

# --- Çalışma modu ---
# true ise bir kere çalışıp çıkar (ör. cron ile tetiklemek için), false ise sürekli döngüde bekler
RUN_ONCE=false
# Sürekli mod için e-posta kutusu kontrol aralığı (ms)
POLL_INTERVAL_MS=300000
