# SQLite for local dev (zero config). To switch to Postgres for production,
# change the datasource provider in prisma/schema.prisma to "postgresql" and
# point this at a Postgres connection string instead.
DATABASE_URL="file:./dev.db"

# Required for the AI concierge (chat + WhatsApp agent) to respond.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional — only needed to connect a real WhatsApp Business number.
# See lib/channels/whatsapp.ts for setup steps. Until these are set, inbound
# WhatsApp messages are still processed by the agent but replies are only
# logged to the server console instead of actually being sent.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_RESTAURANT_SLUG="masa19"
