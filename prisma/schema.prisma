// Prisma schema for the restaurant AI reservation MVP.
// Uses SQLite for zero-config local development. To move to production,
// switch the datasource below to "postgresql" and set DATABASE_URL to a
// Postgres connection string — the models are already Postgres-compatible
// (the only SQLite-specific concession is that enums are modeled as plain
// strings, since SQLite has no native enum type).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                        String   @id @default(cuid())
  slug                      String   @unique
  name                      String
  description               String
  address                   String
  phone                     String
  timezone                  String   @default("Europe/Istanbul")
  openTime                  String // "12:00"
  closeTime                 String // "23:00"
  reservationDurationMinutes Int     @default(90)
  // The seeded "masa19" restaurant that the landing page's "Canlı demo" /
  // "Restoran panelini gör" links point to — its admin dashboard stays open
  // without login so visitors can try it, unlike every real signed-up
  // restaurant. See lib/auth.ts's assertRestaurantAccess().
  isDemo                    Boolean  @default(false)
  // Machine-to-machine POS/reservation-system integration (lib/pos.ts):
  // apiKey authenticates a pull request to /api/restaurants/[slug]/pos/*;
  // posWebhookUrl/Secret are for the push side (notifyPosWebhook). All
  // null until the owner generates/sets them from the dashboard's
  // Settings tab — no POS vendor is integrated by default.
  apiKey                    String?  @unique
  posWebhookUrl             String?
  posWebhookSecret          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  owner     User?
  tables    RestaurantTable[]
  menuItems MenuItem[]
  reservations Reservation[]
  sessions  ConversationSession[]
  whatsappConnection WhatsAppConnection?
  waitlistEntries WaitlistEntry[]
}

// One owner account per restaurant for now — the dashboard has no
// multi-user/role concept yet, just "logged in as this restaurant or not".
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  restaurantId String   @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime @default(now())
}

// A restaurant's own WhatsApp Business phone number, connected through
// Meta's Embedded Signup flow (see lib/whatsapp-onboarding.ts) rather than
// the single shared WHATSAPP_* env vars used by the earlier single-tenant
// stub. `phoneNumberId` is what the inbound webhook uses to route a message
// to the right restaurant; `accessToken` is the system-user token minted
// for that restaurant's WABA during signup.
//
// accessToken is stored in plaintext here because this is a local SQLite
// dev database — a production/Postgres deployment must encrypt it at rest
// (e.g. with a KMS-backed field-level encryption) before going live.
//
// status: "pending" | "connected" | "disconnected"
model WhatsAppConnection {
  id                 String   @id @default(cuid())
  restaurantId       String   @unique
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])
  wabaId             String
  phoneNumberId      String   @unique
  displayPhoneNumber String
  accessToken        String
  status             String   @default("pending")
  connectedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([phoneNumberId])
}

model RestaurantTable {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  capacity     Int
  isActive     Boolean  @default(true)

  reservations Reservation[]

  @@index([restaurantId])
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String
  price        Float
  category     String // e.g. "starter", "main", "dessert", "drink"
  isSpecial    Boolean  @default(false)
  specialDate  DateTime? // only set when isSpecial - the day this special applies
  isAvailable  Boolean  @default(true)

  @@index([restaurantId])
}

// status: "pending" | "confirmed" | "cancelled" | "completed" | "no_show"
// channel: "web" | "whatsapp" | "voice" | "staff" | "external"
model Reservation {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tableId      String?
  table        RestaurantTable? @relation(fields: [tableId], references: [id])
  sessionId    String?
  session      ConversationSession? @relation(fields: [sessionId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?
  partySize     Int
  startsAt      DateTime
  durationMinutes Int    @default(90)
  status        String  @default("pending")
  channel       String  @default("web")
  notes         String?
  // Set only for channel:"external" — the other reservation system's own
  // booking id, so a repeated push from that system updates this row
  // instead of creating a duplicate. See lib/reservations.ts's
  // upsertExternalReservation() and POST /api/restaurants/[slug]/pos/external-bookings.
  externalId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, externalId])
  @@index([restaurantId, startsAt])
  @@index([tableId])
}

// channel: "web" | "whatsapp" | "voice"
model ConversationSession {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  channel      String   @default("web")
  externalId   String? // phone number / WhatsApp wa_id for non-web channels
  customerName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     ConversationMessage[]
  reservations Reservation[]
  waitlistEntries WaitlistEntry[]

  @@index([restaurantId])
  @@index([externalId])
}

// status: "waiting" | "notified" | "seated" | "cancelled" | "expired"
// Created when check_availability finds nothing free for the requested
// slot and the guest asks to be added to the waitlist instead.
model WaitlistEntry {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  sessionId     String?
  session       ConversationSession? @relation(fields: [sessionId], references: [id])
  customerName  String
  customerPhone String
  partySize     Int
  requestedDate String // "YYYY-MM-DD"
  requestedTime String // "HH:MM"
  status        String   @default("waiting")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([restaurantId, requestedDate])
}

// role: "user" | "assistant"
model ConversationMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}
